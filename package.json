{
  "name": "codex-guard-agent",
  "version": "0.1.0",
  "private": true,
  "description": "A chat agent on Cloudflare that checks a proposed change against team engineering standards before a pull request.",
  "type": "module",
  "scripts": {
    "build:client": "esbuild client/main.ts --bundle --format=esm --target=es2022 --minify --outfile=public/app.js --log-level=warning",
    "dev": "wrangler dev --local --var AI_MODE:offline --port 8787",
    "dev:ai": "wrangler dev --var ALLOW_UNAUTHENTICATED_AI:true --port 8787",
    "deploy": "wrangler deploy",
    "deploy:public": "wrangler deploy --var ALLOW_UNAUTHENTICATED_AI:true",
    "gateway:plan": "node scripts/setup-gateway.mjs",
    "gateway:apply": "node scripts/setup-gateway.mjs --apply",
    "types": "wrangler types src/worker-configuration.d.ts --include-runtime=false --strict-vars=false",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p client/tsconfig.json",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "check": "npm run typecheck && npm run test:coverage"
  },
  "dependencies": {
    "@ai-sdk/provider": "^4.0.39",
    "@cloudflare/computer": "^0.8.0",
    "@cloudflare/think": "^0.23.0",
    "agents": "0.33.0",
    "ai": "^7.0.177",
    "just-bash": "^3.6.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.8.5",
    "@cloudflare/workers-types": "^5.20261118.1",
    "@vitest/coverage-istanbul": "^4.1.12",
    "esbuild": "^0.28.2",
    "happy-dom": "^21.0.4",
    "typescript": "^7.0.2",
    "vitest": "^4.1.12",
    "wrangler": "4.165.0"
  },
  "overrides": {
    "undici": "^7.30.1"
  }
}
