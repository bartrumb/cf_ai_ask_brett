{
  "name": "codex-guard-agent",
  "version": "0.1.0",
  "private": true,
  "description": "A chat agent on Cloudflare that checks a proposed change against team engineering standards before a pull request.",
  "type": "module",
  "scripts": {
    "build:client": "esbuild client/main.ts --bundle --format=esm --target=es2022 --minify --outfile=public/app.js --log-level=warning",
    "dev": "wrangler dev --local --var AI_MODE:offline --port 8787",
    "dev:ai": "wrangler dev --port 8787",
    "deploy": "wrangler deploy",
    "types": "wrangler types src/worker-configuration.d.ts --include-runtime=false --strict-vars=false",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p client/tsconfig.json",
    "test": "vitest run",
    "check": "npm run typecheck && npm test"
  },
  "dependencies": {
    "@ai-sdk/provider": "^4.0.39",
    "agents": "0.33.0",
    "ai": "^7.0.177",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.8.5",
    "@cloudflare/workers-types": "^5.20261118.1",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2",
    "vitest": "^4.1.12",
    "wrangler": "4.165.0"
  }
}
