{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "ask-brett",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-18",
  "compatibility_flags": ["nodejs_compat"],
  "build": {
    "command": "npm run build:client",
    "watch_dir": ["client", "content"]
  },
  "assets": {
    "directory": "./public",
    "run_worker_first": ["/agents/*"]
  },
  // Workers AI always runs on Cloudflare. `npm run dev` passes --local and
  // AI_MODE=offline so local work never reaches an account or incurs charges.
  "ai": { "binding": "AI", "remote": true },
  "vars": {
    "AI_MODE": "workers-ai",
    "AI_GATEWAY_ID": "codex-guard",
    // Real model mode refuses connections until both Access values are set.
    "ACCESS_TEAM_DOMAIN": "",
    "ACCESS_AUD": "",
    "ALLOW_UNAUTHENTICATED_AI": "false",
    // Account-wide count of metered AI actions allowed per UTC day.
    "DAILY_AI_ACTION_LIMIT": "500",
    // Daily units for one visitor network. Spoken audio costs five units.
    "DAILY_CLIENT_AI_ACTION_LIMIT": "40"
  },
  "durable_objects": {
    "bindings": [{ "name": "ShowcaseAgent", "class_name": "ShowcaseAgent" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["ShowcaseAgent"] }],
  // Limits how quickly one address can open agent connections.
  "ratelimits": [
    { "name": "CONNECT_LIMIT", "namespace_id": "1101", "simple": { "limit": 30, "period": 60 } },
    // A shared ceiling on metered AI work across all conversations.
    { "name": "AI_ACTION_LIMIT", "namespace_id": "1102", "simple": { "limit": 300, "period": 60 } }
  ],
  // Think emits turn and model spans when traces are enabled.
  "observability": {
    "traces": { "enabled": true, "head_sampling_rate": 1 },
    "logs": { "enabled": true, "head_sampling_rate": 1, "invocation_logs": true }
  }
}
