{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "codex-guard-agent",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-18",
  "compatibility_flags": ["nodejs_compat"],
  "build": {
    "command": "npm run build:client",
    "watch_dir": "client"
  },
  "assets": {
    "directory": "./public",
    "run_worker_first": ["/agents/*"]
  },
  // Workers AI always runs on Cloudflare. `npm run dev` passes --local and
  // AI_MODE=offline so local work never reaches an account or incurs charges.
  "ai": { "binding": "AI", "remote": true },
  "vars": { "AI_MODE": "workers-ai", "AI_GATEWAY_ID": "codex-guard" },
  "durable_objects": {
    "bindings": [{ "name": "CodexGuardAgent", "class_name": "CodexGuardAgent" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["CodexGuardAgent"] }],
  "workflows": [
    {
      "name": "codex-guard-review",
      "binding": "REVIEW_WORKFLOW",
      "class_name": "ReviewWorkflow"
    }
  ],
  "observability": { "enabled": true }
}
